<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The whole point of the spike. These live on the PARENT app bundle, not
         on the sidecar: macOS attributes a child process's TCC requests to the
         responsible process, which should be this app. If the theory is wrong,
         the sidecar records digital silence and we find out here rather than
         after the UI is built. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>meetnote records your microphone so your side of the meeting can be transcribed locally.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>meetnote records this computer's audio so the other participants in the meeting can be transcribed locally.</string>
</dict>
</plist>
