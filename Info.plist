<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>meetnote-capture</string>
    <key>CFBundleIdentifier</key>
    <string>local.meetnote.capture</string>
    <key>CFBundleName</key>
    <string>meetnote capture</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <!-- Background app: no Dock icon, no menu bar. -->
    <key>LSUIElement</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>14.4</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>meetnote records your microphone so your side of the meeting can be transcribed locally.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>meetnote records this computer's audio so the other participants in the meeting can be transcribed locally.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>meetnote reads your calendar to name each meeting and to know who was invited. It never changes anything.</string>
</dict>
</plist>
